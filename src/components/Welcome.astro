---
import Whatsapp from './Iconos/Whatsapp-icono.astro';
import Tiktok from './Iconos/Tiktok-icono.astro';
import Facebook from './Iconos/Facebook-icono.astro';
import Instagram from './Iconos/Instagram-icono.astro';

---

<header class="text-white max-w-xl mx-auto min-h-dvh bg-white flex flex-col items-center">
  <img alt="Power Cleaner Logo" src="/images/power-clean-logo.webp"
    class="h-[40vh] object-cover mask-radial-at-center mask-radial-from-45% mask-radial-to-80% animate-pulse-fade-in">

  <header class="flex flex-col justify-center items-center mb-8 -mt-4">
    <span class="
      text-sky-400 text-xl
      font-mono px-3 py-1
      border border-sky-500/50 rounded-full flex items-center justify-center shadow-sm
      bg-black/65
      cursor-crosshair
      z-10
    ">
      @powercleaner
      <svg class="ml-1 w-5 h-5 text-sky-400 inline" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <path fill-rule="evenodd"
          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707a1 1 0 00-1.414-1.414L9 11.172l-1.293-1.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
          clip-rule="evenodd" />
      </svg>
    </span>

    <h1 class="text-3xl font-extrabold leading-tight mt-1 font-display">
      Power Cleaner
    </h1>
  </header>

  <section class="flex gap-2 justify-center">

	<!-- Whatsapp -->
    <a class="social-button animate-slide-up-fade animate-delay-200 bg-[#047CBD]"
      href="#" target="_blank" aria-label="Whatsapp" title="Ir a Whatsapp de Power Cleaner">
      <Whatsapp class="size-7" />
    </a>
	
	<!-- Tiktok -->
    <a class="social-button animate-slide-up-fade animate-delay-200 bg-[#047CBD]"
      href="#" target="_blank" aria-label="Tiktok" title="Ir a Tiktok de Power Cleaner">
      <Tiktok class="size-7 text-white" />
    </a>
	
	<!-- Facebook -->
    <a class="social-button animate-slide-up-fade animate-delay-200 bg-[#047CBD]"
      href="#" target="_blank" aria-label="Facebook" title="Ir a Facebook de Power Cleaner">
      <Facebook class="size-7 text-white" />
    </a>
	
	<!-- Instagram -->
    <a class="social-button animate-slide-up-fade animate-delay-200 bg-[#047CBD]"
      href="#" target="_blank" aria-label="Instagram" title="Ir a Instagram de Power Cleaner">
      <Instagram class="size-7 text-white" />
    </a>
  </section>

  <p class="text-midu-lol text-center mt-4 text-sm px-4 text-balance">
    Fabricantes de productos de limpieza con fórmulas americanas mejoradas. Venta a mayoreo y menudeo con calidad y servicio superiores.
  </p>

  <main class="pt-4 px-4 pb-16">
    <div class="grid grid-cols-3 grid-rows-2 gap-2 w-full">
      <a href="#" class="
        relative rounded-3xl overflow-hidden
        bg-gradient-to-br from-cyan-900 via-cyan-700 to-cyan-500
        border border-cyan-900
        flex flex-col items-start
        hover:scale-105 hover:contrast-125
        transition
        group
        col-span-2 p-7 min-h-[180px]
      ">
        <span
          class="absolute bottom-2 left-4 font-bold text-2xl group-hover:-translate-y-1 transition-transform">Productos</span>

        <svg
          class="absolute -right-4 -bottom-4 -rotate-6 size-28 group-hover:-rotate-12 group-hover:scale-125 transition-transform"
          width="100" height="100" fill="white">
          <path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"/>
        </svg>

        <span class="absolute top-2 left-4 text-xs border rounded-xl px-1 py-0.5">Línea completa</span>
      </a>

      <a href="#" class="
        relative rounded-3xl overflow-hidden
        bg-gradient-to-br from-[#d30e1c] via-red-500 to-orange-300
        border border-[#d30e1c]
        flex flex-col items-start
        hover:scale-105 hover:contrast-125
        transition
        group
        col-span-1 p-7 min-h-[180px]
      ">
        <span
          class="absolute bottom-2 left-4 font-bold text-2xl group-hover:-translate-y-1 transition-transform">Mayoreo</span>

        <svg
          class="absolute -right-4 -bottom-4 -rotate-6 size-28 group-hover:-rotate-12 group-hover:scale-125 transition-transform"
          width="100" height="100" fill="white">
          <path d="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
        </svg>

        <span class="absolute top-2 left-4 text-xs border rounded-xl px-1 py-0.5">Precios especiales</span>
      </a>

      <a href="#" class="
        relative rounded-3xl overflow-hidden
        bg-gradient-to-br from-[#047CBD] via-blue-600 to-cyan-400
        border border-[#047CBD]
        flex flex-col items-start
        hover:scale-105 hover:contrast-125
        transition
        group
        col-span-1 p-7 min-h-[180px]
      ">
        <span
          class="absolute bottom-2 left-4 font-bold text-2xl group-hover:-translate-y-1 transition-transform">Menudeo</span>

        <svg
          class="absolute -right-4 -bottom-4 -rotate-6 size-28 group-hover:-rotate-12 group-hover:scale-125 transition-transform"
          width="100" height="100" fill="white">
          <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
        </svg>

        <span class="absolute top-2 left-4 text-xs border rounded-xl px-1 py-0.5">Venta al público</span>
      </a>

      <a href="#" class="
        relative rounded-3xl overflow-hidden
        bg-gradient-to-br from-[#663399] via-[#8e44ad] to-purple-400
        border border-[#663399]
        flex flex-col items-start
        hover:scale-105 hover:contrast-125
        transition
        group
        col-span-2 p-7 min-h-[180px]
      ">
        <span
          class="absolute bottom-2 left-4 font-bold text-2xl group-hover:-translate-y-1 transition-transform">Servicios</span>

        <svg
          class="absolute -right-4 -bottom-4 -rotate-6 size-28 group-hover:-rotate-12 group-hover:scale-125 transition-transform"
          width="100" height="100" fill="white">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>

        <span class="absolute top-2 left-4 text-xs border rounded-xl px-1 py-0.5">Calidad superior</span>
      </a>
    </div>
  </main>

</header>