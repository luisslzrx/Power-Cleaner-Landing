      <h3 class="font-bold text-gray-800 text-sm mb-1">Power Cleaner</h3>
      <p class="text-xs text-gray-600">
        Colima, Mexico<br>
        Tel: 312 245 4500<br>
        ventas@powercleanergroup.com
      </p>
    </div>
  </div>
</section>