<section class="pt-8 px-4 pb-16 w-full">
  <!-- Divider con texto centrado -->
  <div class="relative mb-8">
    <div class="absolute inset-0 flex items-center">
      <div class="w-full h-px bg-gradient-to-r from-transparent via-white/60 to-transparent"></div>
    </div>
    <div class="relative flex justify-center">
      <span class="bg-[#D30E1C] px-4 text-sm text-white font-medium">UBICACIÓN</span>
    </div>
  </div>
  
  <h2 class="text-3xl font-bold text-white text-center mb-8">Encuentranos aquí</h2>
  
  <div class="relative rounded-3xl overflow-hidden shadow-lg">
    <!-- Mapa de Google Maps -->
    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3724.670546884687!2d-103.57042534113793!3d19.386521178925182!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x84255f001de7b8f7%3A0x49b62890d33b59a4!2sPower%20Cleaner%20Productos%20de%20Limpieza!5e0!3m2!1ses-419!2smx!4v1777612595580!5m2!1ses-419!2smx" width="600" height="400" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    
