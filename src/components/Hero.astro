
---

---

<img alt="Power Cleaner Logo" src="/images/power-clean-logo.webp"
    class="h-[35vh] object-cover mask-radial-at-center mask-radial-from-45% mask-radial-to-80% animate-pulse-fade-in">

  <header class="flex flex-col justify-center items-center mb-8 -mt-4">
    <!-- Username with verification badge -->
    <div class="flex items-center justify-center gap-1 mt-2">
      <span class=" text-white text-lg font-light">
        El poder de la limpieza
      </span>
      <svg class="w-4 h-4 text-[#047CBD]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <path fill-rule="evenodd"
          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707a1 1 0 00-1.414-1.414L9 11.172l-1.293-1.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
          clip-rule="evenodd" />
      </svg>
    </div>

    <!-- Main title -->
    <h1 class="text-4xl font-bold text-white mb-4">
      Power Cleaner
    </h1>

    <!-- Red horizontal line -->
    <div class="w-16 h-1 bg-white rounded-full"></div>

    <!-- Description paragraph -->
    <p class="text-midu-lol text-center mt-4 text-sm px-4 text-balance">
      Fabricantes de productos de limpieza con fórmulas americanas mejoradas. Venta a mayoreo y menudeo con calidad y servicio superiores.
    </p>

  </header>