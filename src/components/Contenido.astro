---

---

<main class="pt-4 px-4 pb-16 w-full">
    <div class="grid grid-cols-3 grid-rows-2 gap-2 w-full">
      
      <a href="#" class="
        relative rounded-3xl overflow-hidden
        bg-[#047CBD]
        flex flex-col items-start
        hover:scale-105 hover:contrast-125
        transition
        group
        col-span-2 p-7 min-h-[180px]
      ">
        <span
          class="absolute bottom-2 left-4 font-bold text-lg group-hover:-translate-y-1 transition-transform line-clamp-2">Página web</span>

        <svg
          class="absolute -right-4 -bottom-4 -rotate-6 size-28 group-hover:-rotate-12 group-hover:scale-125 transition-transform"
          width="100" height="100" fill="white">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>

        <span class="absolute top-2 left-4 text-xs border rounded-xl px-1 py-0.5 line-clamp-1">Visita nuestro sitio</span>
      </a>

      <a href="#" class="
        relative rounded-3xl overflow-hidden
        bg-[#047CBD]
        flex flex-col items-start
        hover:scale-105 hover:contrast-125
        transition
        group
        col-span-1 p-7 min-h-[180px]
      ">
        <span
          class="absolute bottom-2 left-4 font-bold text-lg group-hover:-translate-y-1 transition-transform line-clamp-2">Correo electrónico</span>

        <svg
          class="absolute -right-4 -bottom-4 -rotate-6 size-28 group-hover:-rotate-12 group-hover:scale-125 transition-transform"
          width="100" height="100" fill="white">
          <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
        </svg>

        <span class="absolute top-2 left-4 text-xs border rounded-xl px-1 py-0.5 line-clamp-1">Contáctanos</span>
      </a>

      <a href="#" class="
        relative rounded-3xl overflow-hidden
        bg-[#047CBD]
        flex flex-col items-start
        hover:scale-105 hover:contrast-125
        transition
        group
        col-span-1 p-7 min-h-[180px]
      ">
        <span
          class="absolute bottom-2 left-4 font-bold text-lg group-hover:-translate-y-1 transition-transform line-clamp-2">Llamada telefónica</span>

        <svg
          class="absolute -right-4 -bottom-4 -rotate-6 size-28 group-hover:-rotate-12 group-hover:scale-125 transition-transform"
          width="100" height="100" fill="white">
          <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
        </svg>

        <span class="absolute top-2 left-4 text-xs border rounded-xl px-1 py-0.5 line-clamp-1">Llámanos ahora</span>
      </a>

      <a href="#" class="
        relative rounded-3xl overflow-hidden
        bg-[#047CBD]
        flex flex-col items-start
        hover:scale-105 hover:contrast-125
        transition
        group
        col-span-2 p-7 min-h-[180px]
      ">
        <span
          class="absolute bottom-2 left-4 font-bold text-lg group-hover:-translate-y-1 transition-transform line-clamp-2">Productos</span>

        <svg
          class="absolute -right-4 -bottom-4 -rotate-6 size-28 group-hover:-rotate-12 group-hover:scale-125 transition-transform"
          width="100" height="100" fill="white">
          <path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"/>
        </svg>

        <span class="absolute top-2 left-4 text-xs border rounded-xl px-1 py-0.5 line-clamp-1">Línea completa</span>
      </a>
    </div>
  </main>