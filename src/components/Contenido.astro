---
import Productos from './Iconos/Productos-icono.astro';
import Limpieza from './Iconos/Limpieza-icono.astro';
---

<main class="pt-8 px-4 w-full">
    <!-- Divider con texto centrado -->
<div class="relative mb-8">
  <div class="absolute inset-0 flex items-center">
    <div class="w-full h-px bg-gradient-to-r from-transparent via-white/60 to-transparent"></div>
  </div>
</div>
    
    <h2 class="text-3xl font-bold text-white text-center mb-6">Contáctanos</h2>
    <div class="space-y-2 w-full">
      
      <!-- Primera fila: 2 tarjetas en columnas -->
      <div class="grid grid-cols-2 gap-2">
        <a href="#" class="
          relative rounded-3xl overflow-hidden
          backdrop-blur-md bg-white border border-gray-200 shadow-2xl
          flex flex-col items-start
          hover:scale-105 hover:contrast-125
          transition
          group
          p-7 min-h-[180px]
        ">
          <span
            class="absolute bottom-2 left-4 font-bold text-lg text-[#047CBD] group-hover:-translate-y-1 transition-transform line-clamp-2">Página web</span>

          <Limpieza 
            class="absolute -right-4 -bottom-4 -rotate-6 size-28 group-hover:-rotate-12 group-hover:scale-125 transition-transform text-red-600 opacity-20 hover:scale-150 active:scale-200 cursor-pointer"
          />

          <span class="absolute top-2 left-4 text-[#047CBD] border rounded-xl px-1 py-0.5 line-clamp-1">Visita nuestro sitio</span>
        </a>

        <a href="#" class="
          relative rounded-3xl overflow-hidden
          backdrop-blur-md bg-white border border-gray-200 shadow-2xl
          flex flex-col items-start
          hover:scale-105 hover:contrast-125
          transition
          group
          p-7 min-h-[180px]
        ">
          <span
            class="absolute bottom-2 left-4 font-bold text-lg text-[#047CBD] group-hover:-translate-y-1 transition-transform line-clamp-2">Productos</span>

          <Productos 
            class="absolute -right-4 -bottom-4 -rotate-6 size-28 group-hover:-rotate-12 group-hover:scale-125 transition-transform text-red-600 opacity-20 hover:scale-150 active:scale-200 cursor-pointer"
          />

          <span class="absolute top-2 left-4 text-[#047CBD] border rounded-xl px-1 py-0.5 line-clamp-1">Línea completa</span>
        </a>
      </div>

      <!-- Segunda fila: tarjeta de ancho completo -->
      <a href="#" class="
        relative rounded-3xl overflow-hidden
        backdrop-blur-md bg-white border border-gray-200 shadow-2xl
        flex flex-col items-start
        hover:scale-105 hover:contrast-125
        transition
        group
        w-full p-7 min-h-[90px]
      ">
        <span
          class="absolute bottom-2 left-4 font-bold text-lg text-[#047CBD] group-hover:-translate-y-1 transition-transform line-clamp-2">Correo electrónico</span>

        <span class="absolute top-2 left-4 text-[#047CBD] border rounded-xl px-1 py-0.5 line-clamp-1">Contáctanos</span>
      </a>

      <!-- Tercera fila: tarjeta de ancho completo -->
      <a href="#" class="
        relative rounded-3xl overflow-hidden
        backdrop-blur-md bg-white border border-gray-200 shadow-2xl
        flex flex-col items-start
        hover:scale-105 hover:contrast-125
        transition
        group
        w-full p-7 min-h-[90px]
      ">
        <span
          class="absolute bottom-2 left-4 font-bold text-lg text-[#047CBD] group-hover:-translate-y-1 transition-transform line-clamp-2">Llamada telefónica</span>

        <span class="absolute top-2 left-4 text-[#047CBD] border rounded-xl px-1 py-0.5 line-clamp-1">Llámanos ahora</span>
      </a>
    </div>
  </main>