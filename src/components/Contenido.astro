---
import Productos from './Iconos/Productos-icono.astro';
import Limpieza from './Iconos/Limpieza-icono.astro';
---

<main class="pt-8 px-4 w-full">
    <!-- Divider con texto centrado -->
<div class="relative mb-8">
  <div class="absolute inset-0 flex items-center">
    <div class="w-full h-px bg-gradient-to-r from-transparent via-white/60 to-transparent"></div>
  </div>
</div>
    
    <h2 class="text-3xl font-bold text-white text-center mb-6">Contáctanos</h2>
    <div class="space-y-2 w-full">
      
      <!-- Tarjeta de ancho completo -->
      <a href="#" class="
        relative rounded-3xl overflow-hidden
        backdrop-blur-md bg-white border border-gray-200 shadow-2xl
        flex flex-col items-start justify-between
        transition
        group
        w-full px-6 py-4       ">
        <div class="flex items-center justify-between w-full">
          <h3 class="text-xl font-bold text-[#047CBD]">Página web</h3>
          <svg class="w-5 h-5 text-[#047CBD]" fill="currentColor" viewBox="0 0 24 24">
