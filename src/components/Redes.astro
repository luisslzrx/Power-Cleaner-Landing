---
import Whatsapp from './Iconos/Whatsapp-icono.astro';
import Tiktok from './Iconos/Tiktok-icono.astro';
import Facebook from './Iconos/Facebook-icono.astro';
import Instagram from './Iconos/Instagram-icono.astro';

---
  
  <section class="flex gap-4 justify-center">
	
	<!-- Tiktok -->
    <a class="social-button animate-slide-up-fade animate-delay-400 bg-white"
      href="https://www.tiktok.com/@elpoderdelalimpieza" target="_blank" aria-label="Tiktok" title="Ir a Tiktok de Power Cleaner">
      <Tiktok class="size-7 text-[#047CBD]" />
    </a>
	
	<!-- Facebook -->
    <a class="social-button animate-slide-up-fade animate-delay-600 bg-white"
      href="https://www.facebook.com/MERICAN.CLEANING.PRODUCTS/" target="_blank" aria-label="Facebook" title="Ir a Facebook de Power Cleaner">
      <Facebook class="size-7 text-[#047CBD]" />
    </a>
	
	<!-- Instagram -->
    <a class="social-button animate-slide-up-fade animate-delay-800 bg-white"
      href="https://www.instagram.com/powercleaner.88" target="_blank" aria-label="Instagram" title="Ir a Instagram de Power Cleaner">
      <Instagram class="size-7 text-[#047CBD]" />
    </a>
    
  </section>
