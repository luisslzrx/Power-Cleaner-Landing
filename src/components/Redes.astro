---
import Whatsapp from './Iconos/Whatsapp-icono.astro';
import Tiktok from './Iconos/Tiktok-icono.astro';
import Facebook from './Iconos/Facebook-icono.astro';
import Instagram from './Iconos/Instagram-icono.astro';

---
  
  <section class="flex gap-2 justify-center">

	<!-- Whatsapp -->
    <a class="social-button animate-slide-up-fade animate-delay-200 bg-white"
      href="#" target="_blank" aria-label="Whatsapp" title="Ir a Whatsapp de Power Cleaner">
      <Whatsapp class="size-7 text-[#047CBD]" />
    </a>
	
	<!-- Tiktok -->
    <a class="social-button animate-slide-up-fade animate-delay-200 bg-white"
      href="#" target="_blank" aria-label="Tiktok" title="Ir a Tiktok de Power Cleaner">
      <Tiktok class="size-7 text-[#047CBD]" />
    </a>
	
	<!-- Facebook -->
    <a class="social-button animate-slide-up-fade animate-delay-200 bg-white"
      href="#" target="_blank" aria-label="Facebook" title="Ir a Facebook de Power Cleaner">
      <Facebook class="size-7 text-[#047CBD]" />
    </a>
	
	<!-- Instagram -->
    <a class="social-button animate-slide-up-fade animate-delay-200 bg-white"
      href="#" target="_blank" aria-label="Instagram" title="Ir a Instagram de Power Cleaner">
      <Instagram class="size-7 text-[#047CBD]" />
    </a>
  </section>

  <section>
    <p class="text-midu-lol text-center mt-4 text-sm px-4 text-balance">
    Fabricantes de productos de limpieza con fórmulas americanas mejoradas. Venta a mayoreo y menudeo con calidad y servicio superiores.
  </p>
  </section>